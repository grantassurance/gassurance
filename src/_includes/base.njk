<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if site.preview %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
{% pageCss css %}
{% pageCss "chrome" %}
</style>
</head>
<body>

<nav{% if navClass %} class="{{ navClass }}"{% endif %}>
  <a href="/" class="nav-logo">
    <span class="nav-logo-name">Grant <span>Assurance</span></span>
    <span class="nav-logo-tag">Assurance for responsible sourcing</span>
  </a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show menu">
  <label for="nav-toggle" class="nav-menu-btn">Menu</label>
  <div class="nav-links">
    {%- for item in nav %}
    <a href="{{ item.url }}"{% if item.key == navActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    <a href="/#contact" class="nav-cta">Get in touch</a>
  </div>
</nav>

{{ content | safe }}

<footer{% if footerClass %} class="{{ footerClass }}"{% endif %}>
  <div style="display:flex; flex-direction:column; line-height:1.2;">
    <span class="footer-logo">Grant <span>Assurance</span></span>
    <span style="font-family:'DM Sans',sans-serif; font-size:9px; letter-spacing:0.18em; text-transform:uppercase; color:#8fad94; margin-top:3px;">Assurance for responsible sourcing</span>
  </div>
  <div class="footer-links">
    {%- for item in nav %}
    <a href="{{ item.url }}">{{ item.label }}</a>
    {%- endfor %}
    <a href="/#about">About</a>
    <a href="/#contact">Contact</a>
  </div>
  <div class="footer-copy">&copy; {{ site.year }} Grant Assurance. All rights reserved.</div>
</footer>

</body>
</html>
